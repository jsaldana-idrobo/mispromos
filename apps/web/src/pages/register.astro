---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthForm from "../components/auth/AuthForm.astro";
import RegisterAside from "../components/auth/RegisterAside.astro";
import { businessTypes, businessTypeLabels } from "../data/catalog";
---

<BaseLayout title="Tus promos | Registro">
  <section class="grid gap-8 lg:grid-cols-[1.1fr,0.9fr]">
    <RegisterAside />
    <AuthForm
      mode="register"
      title="Solicitud de negocio"
      subtitle="Completa los datos de tu negocio. El admin revisa tu solicitud y te avisamos cuando este aprobada."
      hint="Usa una contraseña de al menos 8 caracteres."
      businessTypes={businessTypes}
      businessTypeLabels={businessTypeLabels}
      submitLabel="Enviar solicitud"
    />
  </section>

  <script>
    import "../scripts/auth.ts";
    import "../scripts/register.ts";
  </script>
</BaseLayout>
