---
const {
  mode = "login",
  title = "",
  subtitle = "",
  submitLabel = "Enviar",
  hint = "",
  businessTypes = [],
  businessTypeLabels = {},
} = Astro.props;
---

<div class="glass-panel rounded-3xl p-6">
  {
    title || subtitle ? (
      <div class="mb-5 space-y-2">
        {title ? <h2 class="text-xl font-semibold">{title}</h2> : null}
        {subtitle ? <p class="text-sm text-ink-900/60">{subtitle}</p> : null}
      </div>
    ) : null
  }
  <form class="grid gap-4" data-auth-form data-mode={mode}>
    {
      mode === "register" ? (
        <>
          <label class="grid gap-2 text-sm font-semibold">
            Nombre del negocio
            <input class="input-field" name="name" required />
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Ciudad
            <select
              class="input-field"
              name="city"
              data-register-city-select
              required
            >
              <option value="">Selecciona una ciudad</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Tipo
            <select class="input-field" name="type" required>
              {businessTypes.map((type: string) => (
                <option value={type}>{businessTypeLabels[type] ?? type}</option>
              ))}
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Categorías (selecciona varias)
            <input
              class="input-field"
              type="search"
              placeholder="Buscar categorías..."
              data-register-category-search
            />
            <div
              class="flex flex-wrap gap-2 text-xs text-ink-900/70"
              data-register-category-chips
            />
            <p class="text-xs text-ink-900/60" data-register-category-count>
              Seleccionadas: 0
            </p>
            <div
              class="grid max-h-40 gap-2 overflow-y-auto rounded-2xl border border-ink-900/10 bg-white/70 p-2 text-xs text-ink-900/80"
              data-register-category-results
            >
              <p class="text-ink-900/60">Escribe para buscar categorías.</p>
            </div>
            <select
              class="input-field hidden"
              name="categories"
              data-register-category-select
              size="5"
              multiple
            >
              <option value="">Cargando categorías...</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Descripción
            <textarea class="input-field" name="description" rows={2} />
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Web (opcional)
            <input
              class="input-field"
              name="website"
              placeholder="https://tusitio.com"
            />
            <span class="text-xs font-normal text-ink-900/60">
              Si tienes página web, la mostraremos como enlace principal.
            </span>
          </label>
          <label class="grid gap-2 text-sm font-semibold">
            Instagram (obligatorio)
            <input
              class="input-field"
              name="instagram"
              placeholder="tu_negocio"
              required
            />
            <span class="text-xs font-normal text-ink-900/60">
              Es obligatorio para verificar tu negocio.
            </span>
          </label>
        </>
      ) : null
    }
    <label class="grid gap-2 text-sm font-semibold">
      Email
      <input class="input-field" type="email" name="email" required />
    </label>
    <label class="grid gap-2 text-sm font-semibold">
      Contraseña
      <input
        class="input-field"
        type="password"
        name="password"
        minlength="8"
        required
      />
    </label>
    {hint ? <p class="text-xs text-ink-900/50">{hint}</p> : null}
    <p class="text-sm text-ink-900/60" data-auth-message></p>
    <button class="button-primary" type="submit">{submitLabel}</button>
  </form>
  {
    mode === "register" ? (
      <div
        class="mt-6 hidden rounded-3xl border border-emerald-500/30 bg-emerald-50/70 p-5 text-sm text-ink-900/80"
        data-auth-success
      >
        <p class="text-xs uppercase tracking-[0.2em] text-emerald-800/70">
          Solicitud enviada
        </p>
        <h3 class="mt-2 text-lg font-semibold text-ink-900">
          Revisaremos tu negocio
        </h3>
        <p class="mt-2">
          Gracias por registrarte. Nuestro equipo validará tu Instagram y te
          confirmaremos por correo cuando tu cuenta esté aprobada.
        </p>
        <p class="mt-3 text-xs text-ink-900/60">
          Tiempo estimado: 24 a 48 horas.
        </p>
        <a
          href="/"
          class="mt-4 inline-flex rounded-full border border-ink-900/20 px-4 py-2 text-xs font-semibold"
        >
          Volver al inicio
        </a>
      </div>
    ) : null
  }
</div>
