---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";

const apiBase =
  import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3000/api/v1";
const title = Astro.props.title ?? "Tus promos";
const containerClass = Astro.props.containerClass ?? "max-w-6xl";
const logoSrc = Astro.props.logoSrc ?? "/logo.png";
const logoAlt = Astro.props.logoAlt ?? "Tus promos";
const faviconSrc = "/logo.png";
const rewardedAdUnitPath = import.meta.env.PUBLIC_GAM_REWARDED_AD_UNIT ?? "";
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const hasAuthCookie = cookieHeader.includes("auth=");
---

<!doctype html>
<html lang="es" data-authenticated={hasAuthCookie ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#112d5b" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Tus promos" />
    <meta property="og:image" content={logoSrc} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={logoSrc} />
    <link rel="icon" href={faviconSrc} type="image/png" />
    <link rel="apple-touch-icon" href={faviconSrc} />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2788866499355624"
      crossorigin="anonymous"></script>
    <style>
      html[data-auth-loading="true"] [data-nav-register],
      html[data-auth-loading="true"] [data-nav-rewarded-ad],
      html[data-auth-loading="true"] [data-nav-dashboard],
      html[data-auth-loading="true"] [data-nav-logout] {
        visibility: hidden;
      }
      html[data-authenticated="true"] [data-nav-register] {
        display: none !important;
      }
      html[data-authenticated="true"] [data-nav-dashboard],
      html[data-authenticated="true"] [data-nav-logout] {
        display: inline-flex !important;
      }
      html:not([data-authenticated="true"]) [data-nav-dashboard],
      html:not([data-authenticated="true"]) [data-nav-logout] {
        display: none !important;
      }
      body:not([data-role="ADMIN"]) [data-admin-only] {
        display: none !important;
      }
      .net-loader {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 100%;
        background: linear-gradient(
          90deg,
          rgba(17, 45, 91, 0.15),
          rgba(17, 45, 91, 0.85)
        );
        transform: scaleX(0);
        transform-origin: left;
        opacity: 0;
        transition:
          opacity 0.2s ease,
          transform 0.4s ease;
        z-index: 60;
      }
      html[data-net-loading="true"] .net-loader {
        opacity: 1;
        transform: scaleX(1);
      }
    </style>
    {
      rewardedAdUnitPath ? (
        <script
          is:inline
          async
          src="https://securepubads.g.doubleclick.net/tag/js/gpt.js"
          crossorigin="anonymous"
        />
      ) : null
    }
    <script>
      document.documentElement.dataset.authLoading = "true";
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-ink-900"
    data-api-base={apiBase}
    data-rewarded-ad-unit={rewardedAdUnitPath}
  >
    <div class="min-h-screen bg-white">
      <div class="net-loader" aria-hidden="true"></div>
      <SiteHeader
        isAuthenticated={hasAuthCookie}
        logoSrc={logoSrc}
        logoAlt={logoAlt}
      />
      <main class={`mx-auto w-full px-6 py-10 ${containerClass}`}>
        <slot />
      </main>
      <SiteFooter logoSrc={logoSrc} logoAlt={logoAlt} />
    </div>
    <script type="module" is:inline>
      const apiBase =
        document.body?.dataset?.apiBase || "http://localhost:3000/api/v1";
      const ensureNetLoading = (value) => {
        const globalAny = window;
        if (typeof globalAny.__setNetLoading === "function") {
          globalAny.__setNetLoading(value);
          return;
        }
        if (value) {
          document.documentElement.dataset.netLoading = "true";
        } else {
          delete document.documentElement.dataset.netLoading;
        }
      };
      const dashboardLink = document.querySelector("[data-nav-dashboard]");
      const registerLink = document.querySelector("[data-nav-register]");
      const rewardedAdButton = document.querySelector("[data-nav-rewarded-ad]");
      const logoutButton = document.querySelector("[data-nav-logout]");
      const rewardedAdUnit = (
        document.body?.dataset?.rewardedAdUnit || ""
      ).trim();
      const hasRewardedConfig = rewardedAdUnit.length > 0;
      let rewardedVisible = hasRewardedConfig;
      let latestAuthState =
        document.documentElement.dataset.authenticated === "true";
      const setAuthLinks = (isAuthenticated) => {
        const path = window.location.pathname;
        const isRegisterPage = path.startsWith("/register");
        const isHomePage = path === "/";
        if (dashboardLink) {
          dashboardLink.hidden = !isAuthenticated;
          dashboardLink.style.display = isAuthenticated
            ? "inline-flex"
            : "none";
        }
        if (registerLink) {
          const shouldHide = isAuthenticated || isRegisterPage || !isHomePage;
          registerLink.hidden = shouldHide;
          registerLink.style.display = shouldHide ? "none" : "inline-flex";
        }
        if (rewardedAdButton) {
          const shouldHide =
            isAuthenticated ||
            isRegisterPage ||
            !isHomePage ||
            !rewardedVisible;
          rewardedAdButton.hidden = shouldHide;
          rewardedAdButton.style.display = shouldHide ? "none" : "inline-flex";
        }
        if (logoutButton) {
          logoutButton.hidden = !isAuthenticated;
          logoutButton.style.display = isAuthenticated ? "inline-flex" : "none";
        }
      };
      const setAuthState = (isAuthenticated, role) => {
        latestAuthState = isAuthenticated;
        document.documentElement.dataset.authenticated = isAuthenticated
          ? "true"
          : "false";
        document.documentElement.dataset.authLoading = "false";
        if (isAuthenticated && role) {
          document.body.dataset.role = role;
          document.documentElement.dataset.role = role;
        } else {
          delete document.body.dataset.role;
          delete document.documentElement.dataset.role;
        }
        setAuthLinks(isAuthenticated);
      };
      const readAuthHint = () => {
        try {
          return localStorage.getItem("auth") === "true";
        } catch {
          return false;
        }
      };
      const writeAuthHint = (value) => {
        try {
          if (value) {
            localStorage.setItem("auth", "true");
          } else {
            localStorage.removeItem("auth");
          }
        } catch {
          // ignore storage errors
        }
      };
      const hideRewardedAction = () => {
        rewardedVisible = false;
        setAuthLinks(latestAuthState);
      };
      const setRewardedButtonState = (label, disabled) => {
        if (!rewardedAdButton) {
          return;
        }
        rewardedAdButton.textContent = label;
        rewardedAdButton.disabled = disabled;
      };
      document.documentElement.dataset.authLoading = "true";
      const cookieAuth =
        document.documentElement.dataset.authenticated === "true";
      const authHint = readAuthHint() || cookieAuth;
      setAuthState(authHint);
      const shouldCheckAuth = authHint || cookieAuth;
      if (shouldCheckAuth) {
        ensureNetLoading(true);
        fetch(`${apiBase}/auth/me`, {
          credentials: "include",
          cache: "no-store",
        })
          .then((response) =>
            response.ok
              ? response.json()
              : Promise.resolve({ __status: response.status }),
          )
          .then((user) => {
            if (user && !user.__status) {
              setAuthState(true, user.role);
              writeAuthHint(true);
              return;
            }
            const status = user?.__status;
            if (status === 401 || status === 403) {
              setAuthState(false);
              writeAuthHint(false);
            }
          })
          .catch(() => {
            // keep last known state on network errors
          })
          .finally(() => {
            ensureNetLoading(false);
          });
      }
      if (logoutButton) {
        logoutButton.addEventListener("click", async () => {
          ensureNetLoading(true);
          try {
            await fetch(`${apiBase}/auth/logout`, {
              method: "POST",
              credentials: "include",
            });
          } catch {
            // ignore network errors
          }
          writeAuthHint(false);
          window.location.href = "/login";
          ensureNetLoading(false);
        });
      }
      if (rewardedAdButton) {
        if (!hasRewardedConfig) {
          hideRewardedAction();
        } else {
          const globalAny = window;
          globalAny.googletag = globalAny.googletag || { cmd: [] };
          let rewardedSlot = null;
          let rewardedReadyEvent = null;
          let rewardedLoading = false;

          const requestRewarded = () => {
            if (!rewardedSlot || rewardedLoading) {
              return;
            }
            rewardedLoading = true;
            rewardedReadyEvent = null;
            setRewardedButtonState("Preparando anuncio...", true);
            globalAny.googletag.cmd.push(() => {
              try {
                globalAny.googletag.display(rewardedSlot);
              } catch {
                hideRewardedAction();
              }
            });
          };

          globalAny.googletag.cmd.push(() => {
            const googletag = globalAny.googletag;
            const rewardedFormat = googletag?.enums?.OutOfPageFormat?.REWARDED;
            if (!rewardedFormat) {
              hideRewardedAction();
              return;
            }
            rewardedSlot = googletag.defineOutOfPageSlot(
              rewardedAdUnit,
              rewardedFormat,
            );
            if (!rewardedSlot) {
              hideRewardedAction();
              return;
            }
            rewardedSlot.addService(googletag.pubads());
            googletag
              .pubads()
              .addEventListener("rewardedSlotReady", (event) => {
                rewardedLoading = false;
                rewardedReadyEvent = event;
                setRewardedButtonState("Ver anuncio", false);
              });
            googletag.pubads().addEventListener("rewardedSlotClosed", () => {
              rewardedReadyEvent = null;
              requestRewarded();
            });
            googletag.enableServices();
            requestRewarded();
          });

          rewardedAdButton.addEventListener("click", () => {
            if (
              rewardedReadyEvent &&
              typeof rewardedReadyEvent.makeRewardedVisible === "function"
            ) {
              setRewardedButtonState("Mostrando anuncio...", true);
              rewardedReadyEvent.makeRewardedVisible();
              return;
            }
            requestRewarded();
          });
        }
      }
    </script>
  </body>
</html>
